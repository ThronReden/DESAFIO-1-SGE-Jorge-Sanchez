    <record id="estudio_demo_1" model="modulo_desafio.estudio">
        <field name="nombre">Los Valves</field>
        <field name="descripcion">Nuestro estudio favorito</field>
    </record>
    <record id="estudio_demo_2" model="modulo_desafio.estudio">
        <field name="nombre">Pixel Norte Games</field>
        <field name="descripcion">Estudio independiente especializado en aventuras y juegos de gestión con estética retro</field>
    </record>

    <!-- Videojuegos -->
    <record id="videojuego_demo_1" model="modulo_desafio.videojuego">
        <field name="nombre">Solo Fortress 3</field>
        <field name="descripcion">Juego de disparos en primera persona. Lo nunca visto: ¡Valve y una tercera entrega de una saga de juegos!</field>
        <field name="fecha_lanzamiento">2024-05-20</field>
        <field name="estudio_id" ref="estudio_demo_1"/>
        <field name="precio">0.00</field>
    </record>
    <record id="videojuego_demo_2" model="modulo_desafio.videojuego">
        <field name="nombre">Fractal</field>
        <field name="descripcion">Juego de disparos en primera persona. Lo nunca visto: ¡Valve y una tercera entrega de una saga de juegos!</field>
        <field name="fecha_lanzamiento">2001-01-10</field>
        <field name="estudio_id" ref="estudio_demo_1"/>
        <field name="precio">25.00</field>
        <field name="descuento">15.00</field>
    </record>
    <record id="videojuego_demo_3" model="modulo_desafio.videojuego">
        <field name="nombre">Tierras de Ceniza</field>
        <field name="descripcion">Aventura de rol en un mundo postapocalíptico donde cada decisión cambia el destino de tu aldea.</field>
        <field name="fecha_lanzamiento">2022-11-04</field>
        <field name="estudio_id" ref="estudio_demo_2"/>
        <field name="precio">29.99</field>
        <field name="descuento">20.00</field>
    </record>
    <record id="videojuego_demo_4" model="modulo_desafio.videojuego">
        <field name="nombre">Cosmic Tendero</field>
        <field name="descripcion">Gestiona una tienda de ultramarinos en una estación espacial y sobrevive a los clientes más extraños de la galaxia.</field>
        <field name="fecha_lanzamiento">2025-03-14</field>
        <field name="estudio_id" ref="estudio_demo_2"/>
        <field name="precio">14.50</field>
    </record>

    <!-- Departamentos (el jefe se asigna más abajo, cuando ya existen los empleados) -->
    <record id="departamento_demo_1" model="modulo_desafio.departamento">
        <field name="nombre">Desarrollo</field>
