<odoo>

    <!--Vista de lista-->
    <record id="view_videojuego_list" model="ir.ui.view">
        <field name="name">modulo_desafio.videojuego.list</field>
        <field name="model">modulo_desafio.videojuego</field>
        <field name="arch" type="xml">
            <list string="Lista de Videojuegos">
                <field name="nombre"/>
                <field name="logo"/>
                <field name="fecha_lanzamiento"/>
                <field name="estudio_id"/>
                <field name="precio"/>
                <field name="descuento"/>
                <field name="precio_final"/>
            </list>
        </field>
    </record>

    <!--Vista de formulario-->
    <record id="view_videojuego_form" model="ir.ui.view">
        <field name="name">modulo_desafio.videojuego.form</field>
        <field name="model">modulo_desafio.videojuego</field>
        <field name="arch" type="xml">
            <form string="Ficha del Videojuego">
                <sheet>
                    <group>
                        <field name="nombre"/>
                        <field name="logo"/>
                        <field name="fecha_lanzamiento"/>
                        <field name="estudio_id"/>
                    </group>
                    <group>
                        <field name="precio"/>
                        <field name="descuento"/>
                        <field name="precio_final" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Acción que enlaza las vistas -->
    <record id="action_videojuego" model="ir.actions.act_window">
        <field name="name">Videojuegos</field>
        <field name="res_model">modulo_desafio.videojuego</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_videojuego_list"/>
    </record>

    <!-- Menú para acceder a las diferentes vistas -->
    <menuitem id="menu_videojuego_root" name="Ver Videojuegos" action="action_videojuego"/>
</odoo>