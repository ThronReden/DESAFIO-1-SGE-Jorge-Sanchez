<odoo>

    <!--Vista de lista-->
    <record id="view_empleado_list" model="ir.ui.view">
        <field name="name">modulo_desafio.empleado.list</field>
        <field name="model">modulo_desafio.empleado</field>
        <field name="arch" type="xml">
            <list string="Lista de Empleados">
                <field name="nombre"/>
                <field name="apellidos"/>
                <field name="fecha_nacimiento"/>
                <field name="email"/>
                <field name="departamento_id"/>
            </list>
        </field>
    </record>

    <!--Vista de formulario-->
    <record id="view_empleado_form" model="ir.ui.view">
        <field name="name">modulo_desafio.empleado.form</field>
        <field name="model">modulo_desafio.empleado</field>
        <field name="arch" type="xml">
            <form string="Ficha del empleado">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="nombre" placeholder="Nombre del empleado"/>
                        </h1>
                    </div>
                    <group>
                        <field name="apellidos"/>
                        <field name="fecha_nacimiento"/>
                    </group>
                    <group>
                        <field name="departamento_id"/>
                        <field name="email"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Acción que enlaza las vistas -->
    <record id="action_empleado" model="ir.actions.act_window">
        <field name="name">empleados</field>
        <field name="res_model">modulo_desafio.empleado</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_empleado_list"/>
    </record>
</odoo>